# Build context is an allowlist. Private files must never reach the builder.
**
!Cargo.toml
!Cargo.lock
!src/
!src/**
!examples/
!examples/alac_packet_stream.rs
!wasm/
!wasm/alac-decoder/
!wasm/alac-decoder/Cargo.toml
!wasm/alac-decoder/Cargo.lock
!wasm/alac-decoder/build.sh
!wasm/alac-decoder/README.md
!wasm/alac-decoder/src/
!wasm/alac-decoder/src/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!frontend/tests/
!frontend/tests/**
!scripts/
!scripts/*.py
!scripts/*.mjs
!docs/
!docs/*.md
!.github/
!.github/**
!.gitignore
!.gitattributes
!.dockerignore
!Dockerfile
!compose.yaml
!config.example.toml
!.env.example
!README.md
!CONTRIBUTING.md
!SECURITY.md
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.txt
# Defense in depth if a secret or generated file appears in a source directory.
**/node_modules/**
**/target/**
**/__pycache__/**
**/.DS_Store
**/*.log
**/*.pem
**/*.key
**/*.wvd
**/*.bin
**/.env
**/.env.*
!.env.example
frontend/public/docs/**

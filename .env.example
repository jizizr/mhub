# Compose settings. Copy to .env; never commit the populated file.
# Default access is localhost. Use a protected HTTPS reverse proxy for public access.
MUSIC_BIND_ADDRESS=127.0.0.1
MUSIC_PORT=8000
MUSIC_CONFIG_FILE=./config.toml
RUST_LOG=music_api=info,tower_http=info
# Optional completed-media CDN origin. Frontend changes require a rebuild.
MUSIC_MEDIA_BASE_URL=
# Optional previous CDN origin for persisted queues after a migration.
MUSIC_LEGACY_MEDIA_BASE_URL=
# Optional alternate public Cargo sparse index, with a trailing slash.
# Leave empty to use crates.io normally.
CARGO_INDEX_URL=
